        "end": 106.04,
        "text": "然後再圖層取線的參數裡面提亮"
      },
      {
        "start": 106.76,
        "end": 108.2,
        "text": "這個亮度由你來決定"
      },
      {
        "start": 108.2,
        "end": 109.56,
        "text": "你是希望它只是提亮"
      },
      {
        "start": 109.56,
        "end": 111.72,
        "text": "還是希望它不光是提亮還有反差"
      },
      {
        "start": 111.72,
        "end": 112.76,
        "text": "自己下就定就可以了"
      },
      {
        "start": 112.76,
        "end": 113.96000000000001,
        "text": "好 我們來看一下效果"
      },
      {
        "start": 114.12,
        "end": 115.48,
        "text": "把幾個步驟合併在一起"
      },
      {
        "start": 115.88000000000001,
        "end": 116.76,
        "text": "這之前呢"
      },
      {
        "start": 117.24000000000001,
        "end": 118.04,
        "text": "這是之後的"
      },
      {
        "start": 119.16000000000001,
        "end": 120.36000000000001,
        "text": "那 之前"
      },
      {
        "start": 121.00000000000001,
        "end": 122.60000000000001,
        "text": "之後 之前"
      },
      {
        "start": 123.16000000000001,
        "end": 125.48,
        "text": "之後 好 那麼衣服的這感和衣服的光在感"
      },
      {
        "start": 125.48,
        "end": 126.04,
        "text": "就傳了"
      },
      {
        "start": 126.04,
        "end": 126.68,
        "text": "希望這個支點"
      },
      {
        "start": 126.68,
        "end": 128.36,
        "text": "希望對你有所啟發和幫助"
      }
    ],
