        "start": 230.95999999999998,
        "end": 232.56,
        "text": "如果说后面的光比前面的落"
      },
      {
        "start": 232.56,
        "end": 234.0,
        "text": "你就会觉得是顺光对不对"
      },
      {
        "start": 234.0,
        "end": 236.16,
        "text": "所以后面的光比前面的亮"
      },
      {
        "start": 236.16,
        "end": 237.12,
        "text": "那很简单"
      },
      {
        "start": 237.12,
        "end": 238.39999999999998,
        "text": "如果前面比后面亮"
      },
      {
        "start": 238.39999999999998,
        "end": 239.83999999999997,
        "text": "整个脸就很怪一的"
      },
      {
        "start": 239.83999999999997,
        "end": 240.88,
        "text": "好像这两个骨头"
      },
      {
        "start": 240.88,
        "end": 242.64,
        "text": "这两次的骨头是突出来的"
      },
      {
        "start": 242.64,
        "end": 243.6,
        "text": "但后面比前面亮"
      },
      {
        "start": 243.6,
        "end": 244.79999999999998,
        "text": "是后面的骨头突出来"
      },
      {
        "start": 244.79999999999998,
        "end": 245.67999999999998,
        "text": "为什么会亮"
      },
      {
        "start": 245.67999999999998,
        "end": 246.64,
        "text": "亮是因为突出来"
      },
      {
        "start": 246.64,
        "end": 247.51999999999998,
        "text": "为什么会按按声"
      },
      {
        "start": 247.52,
        "end": 248.24,
        "text": "因为偶像去的时候"
      },
      {
        "start": 248.24,
        "end": 249.28,
        "text": "所以当你突出来的时候"
      },
      {
        "start": 249.28,
        "end": 250.08,
        "text": "他才会亮"
      },
      {
        "start": 250.08,
        "end": 250.8,
        "text": "所以如果我"
      },
      {
        "start": 250.8,
        "end": 252.08,
        "text": "跟从后往前打"
      },
      {
        "start": 252.08,
        "end": 253.68,
        "text": "就是让后面的光比前面的亮"
      },
      {
        "start": 253.68,
        "end": 255.60000000000002,
        "text": "那么是不是说后面的脸"
      },
      {
        "start": 255.60000000000002,
        "end": 256.48,
        "text": "比前面的"
      },
      {
        "start": 256.48,
        "end": 257.44,
        "text": "宽对不对"
      },
      {
        "start": 257.44,
        "end": 259.12,
        "text": "那这样是个相当于我们小姐姐"
      },
      {
        "start": 259.12,
        "end": 260.64,
        "text": "他的前面的脸鞋的很小"
      },
      {
        "start": 260.64,
        "end": 261.52,
        "text": "很刮子"
      },
      {
        "start": 261.52,
        "end": 262.48,
        "text": "所以这就是拿"
      },
      {
        "start": 262.48,
        "end": 264.08,
        "text": "可登光去做一个光影设定"
      },
      {
        "start": 264.08,
        "end": 264.72,
        "text": "就是这么来的"
      }
