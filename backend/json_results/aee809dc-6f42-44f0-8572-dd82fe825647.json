      },
      {
        "start": 72.2,
        "end": 74.84,
        "text": "這四個基本上四個點位五個點位"
      },
      {
        "start": 74.84,
        "end": 76.48,
        "text": "那基本上在光光的頭色上"
      },
      {
        "start": 76.48,
        "end": 79.0,
        "text": "基本上都與付於它基本的亮度"
      },
      {
        "start": 79.0,
        "end": 81.36000000000001,
        "text": "這是每一個2.0點的亮度不太一樣而已"
      },
      {
        "start": 81.36000000000001,
        "end": 83.28,
        "text": "但是基本上都收光前"
      },
      {
        "start": 83.28,
        "end": 84.84,
        "text": "上面中斷下斷"
      },
      {
        "start": 84.84,
        "end": 86.56,
        "text": "就我們說上中下停的光源"
      },
      {
        "start": 86.56,
        "end": 88.0,
        "text": "還都算是比較平均"
      },
      {
        "start": 88.96,
        "end": 92.44,
        "text": "而在我們左邊這張圖光源是左側廠方的光源"
      },
      {
        "start": 92.44,
        "end": 93.8,
        "text": "所以它在兒頭"
      },
      {
        "start": 93.8,
        "end": 96.44,
        "text": "在全股、筆良、人中、下巴"
      },
      {
        "start": 96.44,
        "end": 99.04,
        "text": "基本上光源都靠左上側"
      },
      {
        "start": 99.04,
        "end": 100.96000000000001,
        "text": "也就是說在光源關係裡面"
      },
      {
        "start": 100.96000000000001,
        "end": 102.92,
        "text": "在會有上下亮級關係"
      },
      {
        "start": 102.92,
        "end": 104.32,
        "text": "比如說上停更亮"
      },
      {
        "start": 104.32,
        "end": 106.32,
        "text": "中停刺激下停最安"
      },
      {
        "start": 106.32,
        "end": 109.12,
        "text": "所以明暗關係中顯得稍顯得沒那麼入場"
      },
      {
        "start": 109.12,
        "end": 110.08,
        "text": "這不是最重要的"
      },
      {
        "start": 110.08,
        "end": 112.8,
        "text": "最重要的是由於光源在左側面"
      },
      {
        "start": 112.8,
        "end": 115.2,
        "text": "那麼也就意味著硬一次在右側面"
      },
      {
        "start": 115.2,
        "end": 116.76,
        "text": "所有的硬體在右側面就會導致"
      },
      {
        "start": 116.76,
        "end": 118.96000000000001,
        "text": "所以我們的硬堂,我們的硬堂"
      },
      {
        "start": 118.96000000000001,
        "end": 119.92,
        "text": "我們的探訊"
      },
      {
        "start": 119.92,
        "end": 122.76,
        "text": "我們的這個全筆良側"
      },
      {
        "start": 122.76,
        "end": 124.16000000000001,
        "text": "還有我們的全股"
      },
      {
        "start": 124.16000000000001,
        "end": 126.32000000000001,
        "text": "還有我們的狂人大機、耀機、降口大機"
      },
      {
        "start": 126.32000000000001,
        "end": 127.32000000000001,
        "text": "這一塊雞肉"
      },
      {
        "start": 127.32000000000001,
        "end": 129.24,
        "text": "所產生的敏愛過度變多"
      },
      {
        "start": 129.24,
        "end": 130.72,
        "text": "也就是說這張篇子"
      },
      {
        "start": 130.72,
        "end": 132.20000000000002,
        "text": "之所以沒有像右邊這張篇的"
      },
      {
        "start": 132.20000000000002,
        "end": 133.08,
        "text": "那麼流暢的光線"
      },
      {
        "start": 133.08,
        "end": 133.68,
        "text": "柔和的光線"
      },
      {
        "start": 133.68,
        "end": 136.04000000000002,
        "text": "源自於因為它今天打光的"
      },
      {
        "start": 136.04000000000002,
        "end": 137.64000000000001,
        "text": "這個角度或的早雄光源的角度"
      },
      {
        "start": 137.64000000000001,
        "end": 139.56,
        "text": "所產生的雞肉變化"
      },
      {
        "start": 139.56,
        "end": 142.12,
        "text": "它的結構多樣形"
      },
      {
        "start": 142.12,
        "end": 145.76,
        "text": "也就是說產生結構的多變性"
      },
      {
        "start": 145.76,
        "end": 149.0,
        "text": "導致於我們今天臉部的結構比較豐富"
      },
      {
        "start": 149.0,
        "end": 149.76,
        "text": "或者比較多"
      },
      {
        "start": 149.76,
        "end": 150.79999999999998,
        "text": "那問題就來了"
      },
      {
        "start": 150.79999999999998,
        "end": 152.07999999999998,
        "text": "右邊是比較流暢的"
      },
      {
        "start": 152.07999999999998,
        "end": 153.51999999999998,
        "text": "左邊是沒那麼流暢的"
      },
      {
        "start": 153.51999999999998,
        "end": 154.39999999999998,
        "text": "是不是就意味著"
      },
      {
        "start": 154.39999999999998,
        "end": 156.16,
        "text": "如果我今天把左邊這個臉"
      },
      {
        "start": 156.16,
        "end": 157.44,
        "text": "是刻畫的流暢的你會"
      },
      {
        "start": 157.44,
        "end": 158.44,
        "text": "顯得更好看"
      },
      {
        "start": 158.44,
        "end": 160.84,
        "text": "我們來看一下這是挑戰後的"
      },
      {
        "start": 160.84,
        "end": 161.48,
        "text": "我的助理思維"
      },
      {
        "start": 161.48,
        "end": 163.72,
        "text": "是解決一下太陽學"
      },
      {
        "start": 163.72,
        "end": 165.92,
        "text": "歐縣的這個坑巴太重"
      },
      {
        "start": 165.92,
        "end": 167.35999999999999,
        "text": "導致於高光區中間"
      },
      {
        "start": 167.35999999999999,
        "end": 169.0,
        "text": "去硬區的過度不協調"
      },
      {
        "start": 169.0,
        "end": 171.6,
        "text": "比兩側我們去施向的提來點音鈴"
      },
      {
        "start": 171.6,
        "end": 172.88,
        "text": "進來讓它的比兩"
      },
      {
        "start": 172.88,
        "end": 174.0,
        "text": "從高光區到中間"
      },
      {
        "start": 174.0,
        "end": 175.68,
        "text": "到硬能過度更加流暢"
      },
      {
        "start": 175.68,
        "end": 177.08,
        "text": "而不是一刀切量"
      },
      {
        "start": 177.08,
        "end": 178.72,
        "text": "當然這樣就會導致一比兩"
      },
      {
        "start": 178.72,
        "end": 180.0,
        "text": "會稍微遠認一點"
      },
      {
        "start": 180.0,
        "end": 181.20000000000002,
        "text": "沒那麼硬了"
      },
      {
        "start": 181.20000000000002,
        "end": 182.64000000000001,
        "text": "全顧的區域跟"
      },
      {
        "start": 182.64000000000001,
        "end": 184.0,
        "text": "我們的全顧測區"
      },
      {
        "start": 184.0,
        "end": 185.84,
        "text": "那麼在三角區的速度上"
      },
      {
        "start": 185.84,
        "end": 187.28,
        "text": "去調了一些臥殘"
      },
      {
        "start": 187.28,
        "end": 189.04000000000002,
        "text": "然後協調了全顧測影"
      },
      {
        "start": 189.04000000000002,
        "end": 190.8,
        "text": "和三角區之間的連接"
      },
      {
        "start": 190.8,
        "end": 192.56,
        "text": "讓它顯得沒有那麼強硬的"
      },
      {
        "start": 192.56,
        "end": 193.36,
        "text": "明暗關係的淡"
      },
      {
        "start": 193.36,
        "end": 195.36,
        "text": "顯然也會顯得稍微有點用種"
      },
      {
        "start": 195.36,
        "end": 196.72,
        "text": "人工的區域在"
      },
      {
        "start": 196.72,
        "end": 197.76000000000002,
        "text": "口人家機和人中"
      },
      {
        "start": 197.76000000000002,
        "end": 198.72,
        "text": "這個位置做了一些"
      },
      {
        "start": 198.72,
        "end": 199.28,
        "text": "協調"
      },
      {
        "start": 199.28,
        "end": 201.12,
        "text": "那下巴的部分做了一些簡單的提亮"
      },
      {
        "start": 201.12,
        "end": 203.04000000000002,
        "text": "因為下巴是最靠後的光源"
      },
      {
        "start": 203.04000000000002,
        "end": 205.20000000000002,
        "text": "而搖機和降口雜機的關係上"
      },
      {
        "start": 205.20000000000002,
        "end": 207.84,
        "text": "也做了一些相應的協調和提亮"
      },
      {
        "start": 207.84,
        "end": 208.96,
        "text": "那麼這個時候你可以看到"
      },
      {
        "start": 208.96,
        "end": 210.4,
        "text": "幾乎我們動得都是什麼區域"
      },
      {
        "start": 210.4,
        "end": 211.84000000000003,
        "text": "都是陰影區"
      },
      {
        "start": 211.84000000000003,
        "end": 213.52,
        "text": "高量區域 幾乎沒動"
      },
      {
        "start": 213.52,
        "end": 214.16000000000003,
        "text": "那麼也就是說"
      },
      {
        "start": 214.16000000000003,
        "end": 215.20000000000002,
        "text": "我們是在用陰區"
      },
      {
        "start": 215.20000000000002,
        "end": 216.24,
        "text": "去迎合高量區"
      },
      {
        "start": 216.24,
        "end": 217.84000000000003,
        "text": "讓它變得更協調"
      },
      {
        "start": 217.84000000000003,
        "end": 218.56,
        "text": "揉合"
      },
      {
        "start": 218.56,
        "end": 219.60000000000002,
        "text": "那陰著我們剛才說"
      },
      {
        "start": 219.60000000000002,
        "end": 220.88000000000002,
        "text": "那個很重要的製點"
      },
      {
        "start": 220.88000000000002,
        "end": 222.88000000000002,
        "text": "由於光線的揉核性"
      },
      {
        "start": 222.88000000000002,
        "end": 223.92000000000002,
        "text": "對於美感上"
      },
      {
        "start": 223.92000000000002,
        "end": 224.56,
        "text": "對於武關"
      },
      {
        "start": 224.56,
        "end": 225.12,
        "text": "對於臉部"
      },
      {
        "start": 225.12,
        "end": 226.48000000000002,
        "text": "對於人物的美感上"
      },
      {
        "start": 226.48000000000002,
        "end": 228.00000000000003,
        "text": "它是有其他幫助的作用的"
      },
      {
        "start": 228.00000000000003,
        "end": 229.76000000000002,
        "text": "而且它會讓臉部協調"
      },
      {
        "start": 229.76000000000002,
        "end": 231.60000000000002,
        "text": "揉和更自然更好看"
      },
      {
        "start": 231.60000000000002,
        "end": 232.16000000000003,
        "text": "所以就像我們"
      },
      {
        "start": 232.16000000000003,
        "end": 233.92000000000002,
        "text": "右邊看到這張圖片是一樣的"
      },
      {
        "start": 233.92000000000002,
        "end": 235.76000000000002,
        "text": "它的光源關係更平整"
      },
      {
        "start": 235.76000000000002,
        "end": 236.72000000000003,
        "text": "且更揉和"
      },
      {
        "start": 236.72000000000003,
        "end": 238.96,
        "text": "而我們原先是能攪分明節"
      },
      {
        "start": 238.96,
        "end": 239.84,
        "text": "夠分明"
      },
      {
        "start": 239.84,
        "end": 240.88000000000002,
        "text": "所以會顯得有點"
      },
      {
        "start": 240.88000000000002,
        "end": 242.32000000000002,
        "text": "張或有點亂"
      },
      {
        "start": 242.32000000000002,
        "end": 244.08,
        "text": "所以在樹里思維上"
      },
      {
        "start": 244.08,
        "end": 245.76000000000002,
        "text": "以這個思維區出發"
      },
      {
        "start": 245.76000000000002,
        "end": 246.4,
        "text": "那麼這個片子"
      },
      {
        "start": 246.4,
        "end": 248.00000000000003,
        "text": "會變得更加的流暢切子"
      },
      {
        "start": 248.00000000000003,
        "end": 249.04000000000002,
        "text": "好了那麼回顧一下"
      },
      {
        "start": 249.04000000000002,
        "end": 250.00000000000003,
        "text": "我們今天說了這個點"
      },
      {
        "start": 250.00000000000003,
        "end": 251.04000000000002,
        "text": "光源的流暢"
      },
      {
        "start": 251.04000000000002,
        "end": 252.16000000000003,
        "text": "於否是來自於光源"
      },
      {
        "start": 252.16000000000003,
        "end": 253.52,
        "text": "對結構所產生的"
      },
      {
        "start": 253.52,
        "end": 254.32000000000002,
        "text": "都變形"
      },
      {
        "start": 254.32000000000002,
        "end": 257.12,
        "text": "而大部分刻務群體的更清像於喜歡"
      },
      {
        "start": 257.12,
        "end": 259.52000000000004,
        "text": "揉和切流暢的明暗關係"
      },
      {
        "start": 259.52000000000004,
        "end": 261.36,
        "text": "自然和協調的視覺感"
      },
      {
        "start": 261.36,
        "end": 262.32,
        "text": "而不太喜歡"
      },
      {
        "start": 262.32,
        "end": 263.92,
        "text": "更更挖挖輪輪角角"
      },
      {
        "start": 263.92,
        "end": 265.04,
        "text": "好吧這個是今天"
      },
      {
        "start": 265.04,
        "end": 265.76,
        "text": "關於這個這點"
      },
      {
        "start": 265.76,
        "end": 267.2,
        "text": "希望能你有所起發的幫助"
      }
    ],
