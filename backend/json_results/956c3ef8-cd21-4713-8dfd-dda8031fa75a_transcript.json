    {
      "start": 116.4,
      "end": 116.88000000000001,
      "text": "抽完了以後"
    },
    {
      "start": 116.88000000000001,
      "end": 118.16000000000001,
      "text": "你看是不是就乾淨很多了"
    },
    {
      "start": 118.16000000000001,
