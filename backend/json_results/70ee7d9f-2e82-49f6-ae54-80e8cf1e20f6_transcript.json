    {
      "start": 140.24,
      "end": 140.8,
      "text": "是不是"
    },
    {
      "start": 140.8,
      "end": 142.24,
      "text": "也就是说我们今天的衣化的时候"
    },
    {
      "start": 142.24,
      "end": 143.44,
      "text": "一定要遵守一个基本原则"
    },
    {
      "start": 143.44,
      "end": 143.92000000000002,
      "text": "是什么点呢"
    },
    {
      "start": 143.92000000000002,
      "end": 144.8,
      "text": "就3个点"
    },
    {
      "start": 144.8,
      "end": 146.56,
      "text": "衣服是来决定整体的"
    },
    {
      "start": 146.56,
      "end": 147.52,
      "text": "形体比例的"
    },
    {
      "start": 147.52,
      "end": 148.8,
      "text": "版形呢是在"
    },
    {
      "start": 148.8,
      "end": 150.72,
      "text": "延伸和调整世界藏度的"
    },
    {
      "start": 150.72,
      "end": 151.92000000000002,
      "text": "现调的点位能"
    },
    {
      "start": 151.92000000000002,
      "end": 153.04000000000002,
