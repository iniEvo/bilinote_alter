    },
    {
      "start": 110.0,
      "end": 111.12,
      "text": "好 简单的几个步驻"
    },
    {
      "start": 111.12,
      "end": 112.24000000000001,
      "text": "你看 之前"
    },
    {
      "start": 112.24000000000001,
      "end": 112.88000000000001,
      "text": "之后对吧"
    },
    {
      "start": 112.88000000000001,
      "end": 114.08000000000001,
