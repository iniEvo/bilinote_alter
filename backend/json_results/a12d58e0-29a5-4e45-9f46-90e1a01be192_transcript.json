    },
    {
      "start": 23.8,
      "end": 24.8,
      "text": "你看這是之前的效果"
    },
    {
      "start": 24.8,
      "end": 26.0,
      "text": "是不是也是發蓄發誤"
    },
    {
      "start": 26.0,
      "end": 27.6,
