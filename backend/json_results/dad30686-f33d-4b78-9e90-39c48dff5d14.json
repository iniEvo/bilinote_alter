      {
        "start": 86.60000000000001,
        "end": 88.84,
        "text": "它的暗固中間區的影影色台"
      },
      {
        "start": 88.84,
        "end": 90.60000000000001,
        "text": "同時在每個通道裡面"
      },
      {
        "start": 90.60000000000001,
        "end": 92.60000000000001,
        "text": "掉動它各自有的色彩關係"
      },
      {
        "start": 92.60000000000001,
        "end": 94.04,
        "text": "暗固偏輕我就偏輕"
      },
      {
        "start": 94.04,
        "end": 95.80000000000001,
        "text": "中間偏黃我就家旅"
      },
      {
        "start": 95.80000000000001,
        "end": 97.00000000000001,
        "text": "高光偏藍"
      },
      {
        "start": 97.00000000000001,
        "end": 98.36000000000001,
        "text": "我就在高光裡面加藍"
      },
      {
        "start": 98.36000000000001,
        "end": 99.4,
        "text": "那麼最終啊"
      },
      {
        "start": 99.4,
        "end": 100.76,
        "text": "一張偏子的有沒有交平感"
      },
      {
        "start": 100.76,
        "end": 101.80000000000001,
        "text": "還有最關鍵的一步"
      },
      {
        "start": 101.80000000000001,
        "end": 103.96000000000001,
        "text": "所以是最關鍵的一步的必須要學會達"
      },
      {
        "start": 103.96000000000001,
        "end": 105.08000000000001,
        "text": "在白場上呢"
      },
      {
        "start": 105.08000000000001,
        "end": 106.60000000000001,
        "text": "我們故意壓灰"
      },
      {
        "start": 106.60000000000001,
        "end": 109.16000000000001,
        "text": "那麼中間區的規體量"
      },
      {
        "start": 109.16000000000001,
        "end": 109.88000000000001,
        "text": "黑場呢"
      },
      {
        "start": 109.88000000000001,
        "end": 111.32000000000001,
        "text": "你也可以有做灰一點"
      },
      {
        "start": 111.32000000000001,
        "end": 112.52000000000001,
        "text": "或者變得更暗"
      },
      {
        "start": 112.52000000000001,
        "end": 114.28,
        "text": "那麼這個說你得到的是什麼樣的狀態"
      },
      {
        "start": 114.28,
        "end": 115.80000000000001,
        "text": "就是有一點灰露灰露的感覺"
      },
      {
        "start": 115.8,
        "end": 118.03999999999999,
        "text": "你看我們看之前的之前"
      },
      {
        "start": 118.03999999999999,
        "end": 119.24,
        "text": "之後之前"
      },
      {
        "start": 119.24,
        "end": 120.92,
        "text": "之後有沒有暗固裡面的色彩"
      },
      {
        "start": 120.92,
        "end": 122.03999999999999,
        "text": "中間的色彩高光的色彩"
      },
      {
        "start": 122.03999999999999,
        "end": 124.03999999999999,
        "text": "而且高光是那種柔灰露灰的感覺"
      },
      {
        "start": 124.03999999999999,
        "end": 124.52,
        "text": "OK"
      },
      {
        "start": 124.52,
        "end": 125.64,
        "text": "今天這個支持你"
      },
      {
        "start": 125.64,
        "end": 127.08,
        "text": "希望能給你一些啟發"
      }
    ],
