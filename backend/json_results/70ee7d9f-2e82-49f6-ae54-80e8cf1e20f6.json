      },
      {
        "start": 99.68,
        "end": 100.64,
        "text": "小腿的部分也是"
      },
      {
        "start": 100.64,
        "end": 101.68,
        "text": "那里面腿"
      },
      {
        "start": 101.68,
        "end": 103.2,
        "text": "腿部这个是线条的点位"
      },
      {
        "start": 103.2,
        "end": 104.24000000000001,
        "text": "太靠下了会线"
      },
      {
        "start": 104.24000000000001,
        "end": 105.28,
        "text": "屁股垮下去了"
      },
      {
        "start": 105.28,
        "end": 106.56,
        "text": "而且线的人短"
      },
      {
        "start": 106.56,
        "end": 108.72,
        "text": "所以我们把它的整个线条网上提"
      },
      {
        "start": 108.72,
        "end": 110.0,
        "text": "屁股的网上走"
      },
      {
        "start": 110.0,
        "end": 111.12,
        "text": "好 简单的几个步驻"
      },
      {
        "start": 111.12,
        "end": 112.24000000000001,
        "text": "你看 之前"
      },
      {
        "start": 112.24000000000001,
        "end": 112.88000000000001,
        "text": "之后对吧"
      },
      {
        "start": 112.88000000000001,
        "end": 114.08000000000001,
        "text": "腿线的感受一下之前"
      },
      {
        "start": 114.08000000000001,
        "end": 114.64000000000001,
        "text": "之后有没有感觉"
      },
      {
        "start": 114.64000000000001,
        "end": 115.52000000000001,
        "text": "这个人变得挺8"
      },
      {
        "start": 115.52000000000001,
        "end": 116.96000000000001,
        "text": "且显高了呢"
      },
      {
        "start": 116.96000000000001,
        "end": 118.80000000000001,
        "text": "袖子这些地方也是同理"
      },
      {
        "start": 118.80000000000001,
        "end": 120.16000000000001,
        "text": "一个袖子不合身"
      },
      {
        "start": 120.16000000000001,
        "end": 121.36000000000001,
        "text": "衣服的版形不合身"
      },
      {
        "start": 121.36000000000001,
        "end": 121.92000000000002,
        "text": "就会导臣"
      },
      {
        "start": 121.92000000000002,
        "end": 123.36000000000001,
        "text": "我们今天看到一个衣服"
      },
      {
        "start": 123.36000000000001,
        "end": 124.88000000000001,
        "text": "看上去好像有点大"
      },
      {
        "start": 124.88000000000001,
        "end": 126.00000000000001,
        "text": "或者有点藏"
      },
      {
        "start": 126.00000000000001,
        "end": 127.20000000000002,
        "text": "虽然我知道它就是藏"
      },
      {
        "start": 127.20000000000002,
        "end": 128.56,
        "text": "所以我们把它的整个"
      },
      {
        "start": 128.56,
        "end": 130.16000000000003,
        "text": "衣服的袖套袖子的部分"
      },
      {
        "start": 130.16000000000003,
        "end": 131.44,
        "text": "能给它稍微修直一点"
      },
      {
        "start": 131.44,
        "end": 132.4,
        "text": "当然也不能太直"
      },
      {
        "start": 132.4,
        "end": 134.8,
        "text": "就是顺子它的整体比例稍微修直"
      },
      {
        "start": 134.8,
        "end": 136.08,
        "text": "你会发现它的整个手"
      },
      {
        "start": 136.08,
        "end": 136.64000000000001,
        "text": "变藏了"
      },
      {
        "start": 136.64000000000001,
        "end": 137.52,
        "text": "世界上是变藏了"
      },
      {
        "start": 137.52,
        "end": 138.64000000000001,
        "text": "但是这样没有"
      },
      {
        "start": 138.64000000000001,
        "end": 140.24,
        "text": "来 之前之后"
      },
      {
        "start": 140.24,
        "end": 140.8,
        "text": "是不是"
      },
      {
        "start": 140.8,
        "end": 142.24,
        "text": "也就是说我们今天的衣化的时候"
      },
      {
        "start": 142.24,
        "end": 143.44,
        "text": "一定要遵守一个基本原则"
      },
      {
        "start": 143.44,
        "end": 143.92000000000002,
        "text": "是什么点呢"
      },
      {
        "start": 143.92000000000002,
        "end": 144.8,
        "text": "就3个点"
      },
      {
        "start": 144.8,
        "end": 146.56,
        "text": "衣服是来决定整体的"
      },
      {
        "start": 146.56,
        "end": 147.52,
        "text": "形体比例的"
      },
      {
        "start": 147.52,
        "end": 148.8,
        "text": "版形呢是在"
      },
      {
        "start": 148.8,
        "end": 150.72,
        "text": "延伸和调整世界藏度的"
      },
      {
        "start": 150.72,
        "end": 151.92000000000002,
        "text": "现调的点位能"
      },
      {
        "start": 151.92000000000002,
        "end": 153.04000000000002,
        "text": "决定了它的高低"
      },
      {
        "start": 153.04000000000002,
        "end": 154.72,
        "text": "当然现调也能决定它的藏度"
      },
      {
        "start": 154.72,
        "end": 156.24,
        "text": "OK 这个是我们今天想给大家分享"
      },
      {
        "start": 156.24,
        "end": 156.48000000000002,
        "text": "知点"
      },
      {
        "start": 156.48000000000002,
        "end": 158.08,
        "text": "希望对你有说起发和帮助"
      }
    ],
