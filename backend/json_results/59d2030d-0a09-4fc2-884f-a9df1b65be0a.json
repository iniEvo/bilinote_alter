      },
      {
        "start": 123.08,
        "end": 124.03999999999999,
        "text": "我这个Patreon高光"
      },
      {
        "start": 124.03999999999999,
        "end": 125.08,
        "text": "这个手是八角的部队"
      },
      {
        "start": 125.08,
        "end": 125.88,
        "text": "一开始是这样打的"
      },
      {
        "start": 125.88,
        "end": 126.84,
        "text": "我把它滚点打我的头"
      },
      {
        "start": 126.84,
        "end": 127.84,
        "text": "我身高"
      },
      {
        "start": 127.84,
        "end": 129.0,
        "text": "是不是我的光就落了"
      },
      {
        "start": 129.0,
        "end": 130.0,
