      },
      {
        "start": 135.20000000000002,
        "end": 136.36,
        "text": "就打到了我的"
      },
      {
        "start": 136.36,
        "end": 136.92000000000002,
        "text": "比两上"
      },
      {
        "start": 136.92000000000002,
        "end": 137.96,
        "text": "那么为什么更加暗呢"
      },
      {
        "start": 137.96,
        "end": 138.8,
        "text": "其实很简单"
      },
      {
        "start": 138.8,
        "end": 139.20000000000002,
        "text": "你看"
      },
      {
        "start": 139.20000000000002,
        "end": 140.16,
        "text": "我身高以后"
      },
      {
        "start": 140.16,
        "end": 141.16,
        "text": "虽然更加亮的大这边"
      },
      {
        "start": 141.16,
        "end": 142.88,
        "text": "但是的八角左右两次"
