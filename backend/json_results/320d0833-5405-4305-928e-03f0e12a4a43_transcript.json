    },
    {
      "start": 339.8,
      "end": 341.88,
      "text": "我们要学会去准确的观察"
    },
    {
      "start": 341.88,
      "end": 343.32,
      "text": "影调的走向与分布"
    },
    {
      "start": 343.32,
      "end": 343.84000000000003,
      "text": "那同时呢"
    },
    {
      "start": 343.84000000000003,
      "end": 345.96000000000004,
      "text": "我们要学会控制结构的面"
    },
    {
      "start": 345.96000000000004,
      "end": 346.72,
      "text": "到底是深了"
    },
    {
      "start": 346.72,
      "end": 347.56,
      "text": "还是钱呢"
    },
    {
      "start": 347.56,
      "end": 348.36,
      "text": "名案的变化"
    },
    {
      "start": 348.36,
      "end": 348.96000000000004,
      "text": "应该怎么控制"
    },
    {
      "start": 348.96000000000004,
      "end": 349.96000000000004,
      "text": "或者要小心意义的"
    },
    {
      "start": 349.96000000000004,
      "end": 351.0,
      "text": "去处理这些关系"
    },
    {
      "start": 351.0,
      "end": 351.2,
      "text": "好"
    },
    {
      "start": 351.2,
      "end": 351.68,
      "text": "这个是点"
    },
    {
      "start": 351.68,
      "end": 353.24,
      "text": "希望对你有说起发很帮助"
    }
  ],
