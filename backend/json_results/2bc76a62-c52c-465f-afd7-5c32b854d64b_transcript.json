    },
    {
      "start": 54.24,
      "end": 54.88,
      "text": "來 你看"
    },
    {
      "start": 54.88,
      "end": 55.760000000000005,
      "text": "是不是更乾淨了"
    },
    {
      "start": 55.760000000000005,
      "end": 56.8,
      "text": "來 我們來看一下啊"
    },
    {
      "start": 56.8,
      "end": 58.56,
      "text": "之前之後"
    },
    {
      "start": 58.56,
      "end": 59.6,
      "text": "之前"
    },
    {
      "start": 60.0,
