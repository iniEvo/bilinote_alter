  "segments": [
    {
      "start": 0.0,
      "end": 1.02,
      "text": "那么第一点我观察的"
    },
    {
      "start": 1.02,
      "end": 1.6600000000000001,
      "text": "有个很重要的点"
    },
    {
      "start": 1.6600000000000001,
      "end": 3.34,
      "text": "我们是很多有法令的模特"
    },
    {
      "start": 3.34,
      "end": 4.74,
      "text": "当它名上嘴法令的消失"
    },
    {
      "start": 4.74,
      "end": 6.4,
      "text": "张开嘴法令闻出来了"
    },
    {
      "start": 6.4,
      "end": 6.98,
      "text": "这是没有问题"
    },
    {
      "start": 6.98,
      "end": 7.9,
      "text": "叫做笔记底奥显"
    },
    {
      "start": 7.9,
      "end": 8.2,
      "text": "对一块"
    },
    {
      "start": 8.2,
      "end": 9.200000000000001,
      "text": "不管男人有都是一样的"
    },
    {
      "start": 9.200000000000001,
      "end": 10.1,
      "text": "它这个法令闻比较生"
    },
    {
      "start": 10.1,
      "end": 11.3,
      "text": "明其嘴来法令的消失"
    },
    {
      "start": 11.3,
      "end": 12.200000000000001,
      "text": "所以我们它笔记底奥显"
    },
    {
      "start": 12.200000000000001,
      "end": 13.3,
      "text": "这一点大家都要去给它到"
    },
    {
      "start": 13.3,
      "end": 14.200000000000001,
      "text": "和话中是溝通的时候"
    },
    {
      "start": 14.200000000000001,
      "end": 15.200000000000001,
      "text": "我们就需要溝通一下"
    },
    {
      "start": 15.200000000000001,
      "end": 16.38,
      "text": "还有我刚才说小姐说了"
    },
    {
      "start": 16.38,
      "end": 17.34,
      "text": "眼睛往上看"
    },
    {
      "start": 17.34,
      "end": 18.44,
      "text": "你看他眼睛往上看的时候"
    },
    {
      "start": 18.44,
      "end": 19.2,
      "text": "没毛继呼不动"
    },
    {
      "start": 19.2,
      "end": 20.16,
      "text": "如果你眼睛往上看"
    },
    {
      "start": 20.16,
      "end": 20.900000000000002,
      "text": "没毛会飞起来"
    },
    {
      "start": 20.900000000000002,
      "end": 21.76,
      "text": "说明眼睛无理"
    },
    {
      "start": 21.76,
      "end": 22.8,
      "text": "那么眼睛无理是没有办法"
    },
    {
      "start": 22.8,
      "end": 23.740000000000002,
      "text": "那你就不要让他说了"
    },
    {
      "start": 23.740000000000002,
      "end": 24.8,
      "text": "风伤往下拍一张"
    },
    {
      "start": 24.8,
      "end": 25.64,
      "text": "这个就很糟糕"
    },
    {
      "start": 25.64,
      "end": 26.360000000000003,
      "text": "没毛随才的时候"
    },
    {
      "start": 26.360000000000003,
      "end": 27.18,
      "text": "那你就不要让他"
    },
    {
      "start": 27.18,
      "end": 28.360000000000003,
      "text": "养头往上看的动作"
    },
    {
      "start": 28.360000000000003,
      "end": 29.020000000000003,
      "text": "拍一个很糟了点"
    },
    {
      "start": 29.020000000000003,
      "end": 29.560000000000002,
      "text": "有些人"
    },
    {
      "start": 29.560000000000002,
      "end": 30.96,
      "text": "代眼睛比不太眼睛好看"
    },
    {
      "start": 30.96,
      "end": 31.800000000000004,
      "text": "就是拿一出的问题"
    },
    {
      "start": 31.800000000000004,
      "end": 33.32,
      "text": "是山根山根他了"
    },
    {
      "start": 33.32,
      "end": 33.96,
      "text": "你知道山根在哪"
    },
    {
      "start": 33.96,
      "end": 34.56,
      "text": "对的山根"
    },
    {
      "start": 34.56,
      "end": 35.760000000000005,
      "text": "如果你经常去拍一些"
    },
    {
      "start": 35.760000000000005,
      "end": 36.760000000000005,
      "text": "比较客物色拍的景别"
    },
    {
      "start": 36.760000000000005,
      "end": 37.44,
      "text": "你会发给一个问题"
    },
    {
      "start": 37.44,
      "end": 37.8,
      "text": "有些人"
    },
    {
      "start": 37.8,
      "end": 38.52,
      "text": "他的进景够途"
    },
    {
      "start": 38.52,
      "end": 39.56,
      "text": "看着比原景好看"
    },
    {
      "start": 39.56,
      "end": 40.040000000000006,
      "text": "这个要原景"
    },
    {
      "start": 40.040000000000006,
      "end": 41.2,
      "text": "那么进景比原景好看"
    },
    {
      "start": 41.2,
      "end": 42.56,
      "text": "如果他的进景比原景"
    },
    {
      "start": 42.56,
      "end": 43.160000000000004,
      "text": "看着好看"
    },
    {
      "start": 43.16,
      "end": 44.36,
      "text": "就说明他的连视辨评论"
    },
    {
      "start": 44.36,
      "end": 45.04,
      "text": "那么反过来推"
    },
    {
      "start": 45.04,
      "end": 46.559999999999995,
      "text": "如果你拍一个辨评论的模特"
    },
    {
      "start": 46.559999999999995,
      "end": 47.879999999999995,
      "text": "你进可能拍他的进景"
    },
    {
      "start": 47.879999999999995,
      "end": 49.199999999999996,
      "text": "这样会看着会更加好看"
    }
