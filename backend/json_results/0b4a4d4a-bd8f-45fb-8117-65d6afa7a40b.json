        "start": 38.4,
        "end": 39.8,
        "text": "所以高风该压的要压"
      },
      {
        "start": 40.04,
        "end": 41.08,
        "text": "然后呢白色要压"
      },
      {
        "start": 41.08,
        "end": 42.04,
        "text": "那再有点回灰的"
      },
      {
        "start": 42.04,
        "end": 44.04,
        "text": "那不够灰的白藏在稍微压一点点"
      },
      {
        "start": 44.04,
        "end": 45.92,
        "text": "然后呢中间去是有反差的别忘了啊"
      },
      {
        "start": 45.92,
        "end": 47.2,
        "text": "然后按部要发灰"
      },
      {
        "start": 47.2,
        "end": 48.239999999999995,
        "text": "但是不能太灰"
      },
      {
        "start": 48.239999999999995,
        "end": 49.480000000000004,
        "text": "啊,因为要交变感吧"
      },
      {
        "start": 49.480000000000004,
        "end": 51.760000000000005,
        "text": "好,那么这个是整理影调的控制啊"
      },
      {
        "start": 51.760000000000005,
        "end": 52.519999999999996,
        "text": "色彩方面呢"
      },
      {
        "start": 52.519999999999996,
        "end": 53.56,
        "text": "我们要去的中间调里边"
      },
      {
        "start": 53.56,
        "end": 54.4,
        "text": "偏很多的黄色"
      },
      {
        "start": 57.64,
        "end": 59.04,
        "text": "黄色完了以后你再去赶"
      },
      {
        "start": 59.04,
        "end": 59.68,
        "text": "就好赶了"
      },
      {
        "start": 59.68,
        "end": 60.32,
        "text": "所以我们在"
      },
      {
        "start": 60.32,
        "end": 62.44,
        "text": "服色的中间直到去混合出一些"
      },
      {
        "start": 62.44,
        "end": 64.8,
        "text": "黄调的调形和色感啊"
      },
      {
        "start": 64.8,
        "end": 67.52,
        "text": "那么在暗部里边的有那么一丁丁的阳红"
      },
      {
        "start": 67.52,
        "end": 69.72,
        "text": "所以我们在暗部里面讲一点点阳红"
      },
      {
        "start": 69.72,
        "end": 71.92,
        "text": "好了,那么这个主色整体关系就出来了"
      },
      {
        "start": 71.92,
        "end": 72.4,
        "text": "你看"
      },
      {
        "start": 72.4,
        "end": 73.92,
        "text": "所以呢,但是色彩不够爆满了"
      },
      {
        "start": 73.92,
        "end": 74.36,
        "text": "怎么办呢"
      },
      {
        "start": 74.36,
        "end": 75.2,
        "text": "所以才不够爆满了"
      },
      {
        "start": 75.2,
        "end": 76.92,
        "text": "我们就去加色纸"
      },
      {
        "start": 76.92,
        "end": 77.52,
        "text": "再加尔"
      },
      {
        "start": 77.52,
        "end": 78.6,
        "text": "才自然保护肚里边"
      },
      {
        "start": 78.6,
        "end": 79.16,
        "text": "阿伙的保折"
      },
      {
        "start": 79.16,
        "end": 79.96000000000001,
        "text": "这样保折是在"
      },
      {
        "start": 79.96000000000001,
        "end": 80.56,
        "text": "绿人色"
      },
      {
        "start": 80.56,
        "end": 81.6,
        "text": "因为服色里面有大量的绿"
      },
      {
        "start": 81.6,
        "end": 83.0,
        "text": "包括说这个背景啊"
      },
      {
        "start": 83.0,
        "end": 83.8,
        "text": "所以背景颜色呢"
      },
      {
        "start": 86.68,
        "end": 88.16000000000001,
        "text": "绿色的保折加高量的色纸"
      },
      {
        "start": 88.16000000000001,
        "end": 89.04,
        "text": "跟绿一点"
      },
      {
        "start": 89.04,
        "end": 90.08000000000001,
        "text": "然后的色象上面呢"
      },
      {
        "start": 90.08000000000001,
        "end": 91.32000000000001,
        "text": "也可以稍微冷一点点"
      },
      {
        "start": 91.32000000000001,
        "end": 92.60000000000001,
        "text": "把这名度呢"
      },
      {
        "start": 92.60000000000001,
        "end": 93.32000000000001,
        "text": "该压在压下来"
      },
      {
        "start": 93.32000000000001,
        "end": 94.12,
        "text": "黄色也是"
      },
      {
        "start": 94.12,
        "end": 95.52000000000001,
        "text": "有一部位控制到服色"
      },
      {
        "start": 95.52000000000001,
        "end": 96.4,
        "text": "所以就还好"
      },
      {
        "start": 96.4,
        "end": 98.4,
        "text": "这个大体的色彩关系就有了"
      },
      {
        "start": 98.4,
        "end": 99.60000000000001,
        "text": "然后的色象方面呢"
      },
      {
        "start": 99.60000000000001,
        "end": 100.32000000000001,
        "text": "这个黄色呢"
      },
      {
        "start": 100.32000000000001,
        "end": 101.16000000000001,
        "text": "可以稍微改改"
      },
      {
        "start": 101.16000000000001,
        "end": 101.76,
        "text": "这个红啊"
      },
      {
        "start": 101.76,
        "end": 102.48,
        "text": "不要太红"
      },
      {
        "start": 102.48,
        "end": 103.24000000000001,
        "text": "太红了以后呢"
      },
      {
        "start": 103.24000000000001,
        "end": 103.92000000000002,
        "text": "就会有点"
      },
      {
        "start": 103.92000000000002,
        "end": 104.96000000000001,
        "text": "太重了一点"
      },
      {
        "start": 104.96000000000001,
        "end": 105.44000000000001,
        "text": "之前"
      },
      {
        "start": 105.44000000000001,
        "end": 105.80000000000001,
        "text": "之后"
      },
      {
        "start": 105.80000000000001,
        "end": 106.4,
        "text": "之前之后"
      },
      {
        "start": 106.4,
        "end": 107.2,
        "text": "还点个确定"
      },
      {
        "start": 107.2,
        "end": 107.80000000000001,
        "text": "你看"
      },
      {
        "start": 107.80000000000001,
        "end": 109.64000000000001,
        "text": "是不是大体的色彩关系就有了"
      },
      {
        "start": 109.64000000000001,
        "end": 111.04,
        "text": "包括像直背的这些绿"
      },
      {
        "start": 111.04,
        "end": 111.92000000000002,
        "text": "包括服色啊"
      },
      {
        "start": 111.92000000000002,
        "end": 112.92000000000002,
        "text": "基本关系就出来了"
      },
      {
        "start": 112.92,
        "end": 114.8,
        "text": "然后按不里面的阳头差了一点点"
      },
      {
        "start": 114.8,
        "end": 115.84,
        "text": "你看它是那种"
      },
      {
        "start": 115.84,
        "end": 116.48,
        "text": "比较深的"
      },
      {
        "start": 116.48,
        "end": 117.96000000000001,
        "text": "所以找到科学颜色"
      },
      {
        "start": 117.96000000000001,
        "end": 119.48,
        "text": "首先把绿色的直背的颜色"
      },
      {
        "start": 119.48,
        "end": 120.36,
        "text": "名度压低"
      },
      {
        "start": 120.36,
        "end": 121.36,
        "text": "那它按下去"
      },
      {
        "start": 121.36,
        "end": 122.52,
        "text": "然后黑色里面是有阳头的"
      },
      {
        "start": 122.52,
        "end": 123.76,
        "text": "所以我们在黑色里面加点阳头"
      },
      {
        "start": 123.76,
        "end": 124.84,
        "text": "一点点别多"
      },
      {
        "start": 124.84,
        "end": 126.4,
        "text": "多了以后就有点"
      },
      {
        "start": 126.4,
        "end": 127.24000000000001,
        "text": "就怎么说呢"
      },
      {
        "start": 127.24000000000001,
        "end": 128.4,
        "text": "就是太子了一点"
      },
      {
        "start": 128.4,
        "end": 129.2,
        "text": "服色的黄已经有了"
      },
      {
        "start": 129.2,
        "end": 130.32,
        "text": "但是就像我刚才说的"
      },
      {
        "start": 130.32,
        "end": 131.36,
        "text": "我们加的赛红不够"
      },
      {
        "start": 131.36,
        "end": 131.8,
        "text": "对不对"
      },
      {
        "start": 131.8,
        "end": 132.2,
        "text": "赛红不够"
      },
      {
        "start": 132.2,
        "end": 132.88,
        "text": "所以不够"
      },
      {
        "start": 132.88,
        "end": 133.88,
        "text": "所以这里面呢"
      },
      {
        "start": 133.88,
        "end": 135.44,
        "text": "找到比如说科学颜色"
      },
      {
        "start": 135.44,
        "end": 137.24,
        "text": "然后找到黄色"
      },
      {
        "start": 137.24,
        "end": 137.92000000000002,
        "text": "偏黄"
      },
      {
        "start": 137.92000000000002,
        "end": 138.52,
        "text": "偏阳红"
      },
      {
        "start": 138.52,
        "end": 139.16,
        "text": "偏阳红"
      },
      {
        "start": 139.16,
        "end": 140.76,
        "text": "然后黄马该住"
      },
      {
        "start": 140.76,
        "end": 142.12,
        "text": "华里自己擦出来"
      },
      {
        "start": 142.12,
        "end": 143.35999999999999,
        "text": "把这一个部分擦出来"
      },
      {
        "start": 143.35999999999999,
        "end": 144.28,
        "text": "你看小伙包的"
      },
      {
        "start": 144.28,
        "end": 145.64,
        "text": "这个可爱的粉粉的感觉就有了"
      },
      {
        "start": 145.64,
        "end": 146.24,
        "text": "是不是"
      },
      {
        "start": 146.24,
        "end": 147.16,
        "text": "然后这一块儿呢"
      },
      {
        "start": 147.16,
        "end": 148.0,
        "text": "还是有点灰了"
      },
      {
        "start": 148.0,
        "end": 149.76,
        "text": "你的单独再加一点好了"
      },
      {
        "start": 149.76,
        "end": 150.76,
        "text": "黑色"
      },
      {
        "start": 150.76,
        "end": 152.0,
        "text": "找到黑色"
      },
      {
        "start": 152.0,
        "end": 152.76,
        "text": "加下去"
      },
      {
        "start": 152.76,
        "end": 153.44,
        "text": "然后的凡血"
      },
      {
        "start": 153.44,
        "end": 154.2,
        "text": "把这偷发单独"
      },
      {
        "start": 154.2,
        "end": 155.44,
        "text": "因为我刚才提挥"
      },
      {
        "start": 155.44,
        "end": 156.8,
        "text": "可能提挥提多了一点"
      },
      {
        "start": 156.8,
        "end": 158.35999999999999,
        "text": "但这个问题不是很大"
      },
      {
        "start": 158.35999999999999,
        "end": 158.51999999999998,
        "text": "好了"
      },
      {
        "start": 158.51999999999998,
        "end": 159.12,
        "text": "你看"
      },
      {
        "start": 159.12,
        "end": 160.6,
        "text": "这片子里面我们总共就做了几步"
      },
      {
        "start": 160.6,
        "end": 162.35999999999999,
        "text": "一个是绿色的加深"
      },
      {
        "start": 162.35999999999999,
        "end": 163.48,
        "text": "一个是三红"
      },
      {
        "start": 163.48,
        "end": 164.76,
        "text": "是当给一点点"
      },
      {
        "start": 164.76,
        "end": 165.48,
        "text": "但这个粉"
      },
      {
        "start": 165.48,
        "end": 167.48,
        "text": "好像还有点点粉的一点"
      },
      {
        "start": 167.48,
        "end": 169.56,
        "text": "洋红微关系在稍微调一下"
      },
      {
        "start": 169.56,
        "end": 170.48,
        "text": "洋红给多了"
      },
      {
        "start": 170.48,
        "end": 172.88,
        "text": "应该是举层色"
      },
      {
        "start": 172.88,
        "end": 174.12,
        "text": "去层色为一个很稀一点"
      },
      {
        "start": 174.12,
        "end": 175.23999999999998,
        "text": "然后再子就偷发"
      },
      {
        "start": 175.23999999999998,
        "end": 175.95999999999998,
        "text": "稍微有点多了"
      },
      {
        "start": 175.95999999999998,
        "end": 177.39999999999998,
        "text": "所以又调了一点点"
      },
      {
        "start": 177.39999999999998,
        "end": 177.44,
        "text": "来"
      },
      {
        "start": 177.44,
        "end": 178.51999999999998,
        "text": "看一下"
      },
      {
        "start": 178.51999999999998,
        "end": 179.39999999999998,
        "text": "之前"
      },
      {
        "start": 179.39999999999998,
        "end": 180.12,
        "text": "之后"
      },
      {
        "start": 180.12,
        "end": 180.6,
        "text": "之前"
      },
      {
        "start": 180.6,
        "end": 181.12,
        "text": "之后"
      },
      {
        "start": 181.12,
        "end": 181.28,
        "text": "好"
      },
      {
        "start": 181.28,
        "end": 181.79999999999998,
        "text": "这个制定"
      },
      {
        "start": 181.79999999999998,
        "end": 183.56,
        "text": "希望对于你有所起发和帮助"
      }
